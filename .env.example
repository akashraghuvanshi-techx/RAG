# ================================================================
# Sovereign Multimodal Local RAG Configuration
# Designed for Refineries, PSUs, Defense & Sovereign Workbenches
# ================================================================

# Sovereign Mode: When true, strictly disables any external network access.
# Fail-closed if external APIs/models are attempted.
SOVEREIGN_MODE=true

# Storage Directories
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
QDRANT_STORAGE_PATH=./data/qdrant
LOG_DIR=./logs

# Vector Database (Qdrant)
# If QDRANT_URL is empty, runs in embedded local disk mode (zero external daemon needed)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sovereign_knowledge_base

# Relational / Metadata Database
# Uses SQLite locally by default (zero external daemon). Can point to PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sovereign_rag
DATABASE_URL=sqlite:///./data/metadata.db

# Embedding Model (Local Sentence Transformers or ONNX)
# Local model name or path to offline directory
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Local Cross-Encoder Reranker
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
RERANKER_TOP_K=10

# Hybrid Retrieval Settings
VECTOR_SEARCH_LIMIT=30
BM25_SEARCH_LIMIT=30
RRF_K=60

# OCR Configuration
OCR_ENGINE=rapidocr
OCR_CONFIDENCE_THRESHOLD=0.5
OCR_SCANNED_MIN_CHAR_THRESHOLD=50

# Local LLM Serving (Optional: for answer synthesis)
# Supported: Local Ollama / vLLM / llama.cpp OpenAI-compatible endpoint
LLM_ENDPOINT=http://127.0.0.1:11434/v1
LLM_MODEL=llama3:8b
LLM_TIMEOUT=60

# API Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=INFO
